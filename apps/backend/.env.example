# Server
PORT=3000
NODE_ENV=development
# Publicly reachable base URL for this backend - used to build the Gmail OAuth
# redirect URI (must be registered exactly in Google Cloud Console credentials)
PUBLIC_BASE_URL=http://localhost:3000
# Deep link scheme the mobile app registers (see apps/mobile/app.json "scheme") -
# used to redirect back into the app after the Gmail consent screen completes
MOBILE_DEEP_LINK_SCHEME=budgetmail

# Database (matches docker-compose.yml postgres service)
DATABASE_URL="postgresql://budgetmail:budgetmail_dev_password@localhost:5434/budgetmail?schema=public"

# Redis (matches docker-compose.yml redis service)
REDIS_URL="redis://localhost:6379"

# Google OAuth - fill in after creating the OAuth consent screen (see docs/TASKS.md Fase 0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Optional - Claude API for LLM-based transaction parsing. Leave empty to use the
# built-in rule-based extractor (no external API needed).
ANTHROPIC_API_KEY=

# Symmetric key used to encrypt Gmail refresh tokens at rest (Fase 1+).
# Must be a base64-encoded 32-byte key, e.g. generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
