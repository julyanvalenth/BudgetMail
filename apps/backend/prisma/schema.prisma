generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  googleId  String   @unique @map("google_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  gmailConnection GmailConnection?
  categories      Category[]
  transactions    Transaction[]
  syncJobs        SyncJob[]
  budgets         Budget[]

  @@map("users")
}

model GmailConnection {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenEncrypted  String    @map("refresh_token_encrypted")
  scope                  String
  syncStatus             String    @default("not_connected") @map("sync_status")
  lastSyncedAt           DateTime? @map("last_synced_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("gmail_connections")
}

model Category {
  id     String  @id @default(uuid())
  userId String? @map("user_id") // null = default/global category
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  icon   String
  type   String // "income" | "expense"

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@map("categories")
}

model Transaction {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          String // "gmail" | "manual"
  gmailMessageId  String?   @unique @map("gmail_message_id")
  merchant        String
  amount          Decimal   @db.Decimal(14, 2)
  type            String // "income" | "expense"
  categoryId      String?   @map("category_id")
  category        Category? @relation(fields: [categoryId], references: [id])
  transactionDate DateTime  @map("transaction_date")
  confidenceScore Float?    @map("confidence_score")
  status          String    @default("pending_review") // "pending_review" | "confirmed" | "ignored"
  rawSnippet      String?   @map("raw_snippet")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, transactionDate])
  @@map("transactions")
}

model SyncJob {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              String    @default("running") // "running" | "completed" | "failed"
  startedAt           DateTime  @default(now()) @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  emailsScanned       Int       @default(0) @map("emails_scanned")
  transactionsCreated Int       @default(0) @map("transactions_created")
  errorMessage        String?   @map("error_message")

  @@map("sync_jobs")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month       String // "YYYY-MM"
  amountLimit Decimal  @map("amount_limit") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month])
  @@map("budgets")
}
