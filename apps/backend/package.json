{
  "name": "@budgetmail/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@budgetmail/shared-types": "workspace:*",
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.7",
    "@prisma/client": "^6.1.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2",
    "@anthropic-ai/sdk": "^0.32.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "prisma": "^6.1.0",
    "@types/node": "^22.10.2",
    "@types/jsonwebtoken": "^9.0.7",
    "vitest": "^2.1.8"
  }
